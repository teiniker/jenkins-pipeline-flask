// Acceptance Stage: deploy the Release Candidate of the Commit Stage
// and run the acceptance tests against the running service
pipeline
{
    agent any

    // Start after every successful build of the CI pipeline
    triggers
    {
        upstream(upstreamProjects: 'Flask CI Pipeline',
                 threshold: hudson.model.Result.SUCCESS)
    }

    environment
    {
        VENV_DIR = ".venv"
        FLASK_PORT = "9090"
        BOOK_SERVICE_URL = "http://localhost:${FLASK_PORT}/books"
    }

    stages
    {
        stage('download wheel')
        {
            steps
            {
                echo 'Copy the Release Candidate from the CI pipeline'
                sh 'rm -rf dist'
                // The build which triggered this pipeline, or the last
                // successful one if we start the pipeline manually
                copyArtifacts(
                    projectName: 'Flask CI Pipeline',
                    filter: 'dist/*.whl',
                    target: '.',
                    fingerprintArtifacts: true,
                    selector: upstream(fallbackToLastSuccessful: true)
                )
                sh 'ls -l dist'
            }
        }

        stage('install wheel')
        {
            steps
            {
                echo 'Install the Release Candidate into a new virtual environment'
                sh """
                    rm -rf ${VENV_DIR}
                    python3 -m venv ${VENV_DIR}
                    ./${VENV_DIR}/bin/pip install requests
                    ./${VENV_DIR}/bin/pip install dist/*.whl
                """
            }
        }

        stage('start service')
        {
            steps
            {
                echo "Start the book service in background on port ${FLASK_PORT}"
                sh """
                    # Start the installed service (not the source code!)
                    nohup ./${VENV_DIR}/bin/book-service --port ${FLASK_PORT} > service.log 2>&1 &
                    echo \$! > service.pid

                    # Wait until the service answers (max. 10 seconds)
                    for i in \$(seq 1 20); do
                        if ./${VENV_DIR}/bin/python -c "import urllib.request; urllib.request.urlopen('${BOOK_SERVICE_URL}', timeout=1)" 2>/dev/null; then
                            echo "Service is up"
                            exit 0
                        fi
                        sleep 0.5
                    done
                    echo "Service did not start:"
                    cat service.log
                    exit 1
                """
            }
        }

        stage('acceptance tests')
        {
            steps
            {
                echo 'Run acceptance tests against the running service'
                sh """
                    ./${VENV_DIR}/bin/python -m unittest discover \
                        --start-directory tests/acceptance --pattern '*_test.py' --verbose
                """
            }
        }
    }

    post
    {
        always
        {
            echo 'Stop the book service'
            sh """
                if [ -f service.pid ]; then
                    kill \$(cat service.pid) || true
                    rm service.pid
                fi
            """
        }
    }
}
