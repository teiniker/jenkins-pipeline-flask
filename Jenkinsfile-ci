// Commit Stage: test the code and create the Release Candidate (wheel file)
pipeline
{
    agent any

    environment
    {
        VENV_DIR = ".venv"
    }

    stages
    {
        stage('setup')
        {
            steps
            {
                echo 'Setup stage: create Python virtual environment'
                sh """
                    python3 -m venv ${VENV_DIR}
                    ./${VENV_DIR}/bin/pip install build
                    ./${VENV_DIR}/bin/pip install --editable .
                """
            }
        }

        stage('unit test')
        {
            steps
            {
                echo 'Test stage: run unit tests (no running server needed)'
                sh """
                    ./${VENV_DIR}/bin/python -m unittest discover \
                        --start-directory tests/unit --pattern '*_test.py' --verbose
                """
            }
        }

        stage('package')
        {
            steps
            {
                echo 'Build stage: build wheel'
                sh """
                    rm -rf dist
                    ./${VENV_DIR}/bin/python -m build --wheel --outdir dist
                """
            }
        }
    }

    post
    {
        success
        {
            echo 'Archive the Release Candidate'
            archiveArtifacts artifacts: 'dist/*.whl', fingerprint: true
        }
    }
}
